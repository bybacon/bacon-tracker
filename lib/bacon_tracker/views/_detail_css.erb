.detail-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(40, 20, 32, 0.5);
  padding: 24px;
}
.detail-backdrop.open {
  display: flex;
}
.detail-modal {
  background: #fff;
  border: 1px solid rgba(195, 195, 195, 0.4);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  box-shadow: 0 14px 44px rgba(0, 0, 0, 0.28);
  width: min(680px, 100%);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding: 15px 18px;
}
[data-theme="dark"] .detail-modal {
  background: #2a1d26;
  border-color: rgba(255, 255, 255, 0.09);
}
.detail-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 9px;
}
.detail-id {
  font-size: 0.66rem;
  color: var(--fg-muted);
}
/* Where the thing stands right now - the story's stage, the record's status.
   The detail view is read on its own, away from the column that would have
   said it, so the pill carries the same colour the column header does. */
.detail-stage {
  font-size: 0.58rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--fg-muted);
  background: rgba(195, 195, 195, 0.14);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 1px 7px;
  line-height: 1.55;
  white-space: nowrap;
}
.detail-stage[data-stage="1_icebox"] {
  color: var(--c-chore);
  background: rgba(107, 144, 160, 0.13);
  border-color: rgba(107, 144, 160, 0.4);
}
.detail-stage[data-stage="2_backlog"] {
  color: var(--accent);
  background: rgba(192, 130, 162, 0.14);
  border-color: rgba(192, 130, 162, 0.42);
}
.detail-stage[data-stage="3_started"] {
  color: #5e8c6a;
  background: rgba(80, 140, 100, 0.13);
  border-color: rgba(80, 140, 100, 0.4);
}
.detail-stage[data-status="proposed"] {
  color: var(--accent);
  background: rgba(192, 130, 162, 0.14);
  border-color: rgba(192, 130, 162, 0.42);
}
.detail-stage[data-status="accepted"] {
  color: #5e8c6a;
  background: rgba(80, 140, 100, 0.13);
  border-color: rgba(80, 140, 100, 0.4);
}
.detail-stage[data-status="rejected"] {
  color: var(--c-bug);
  background: rgba(212, 112, 112, 0.12);
  border-color: rgba(212, 112, 112, 0.4);
}
.detail-close {
  margin-left: auto;
  background: none;
  border: none;
  color: var(--fg-muted);
  cursor: pointer;
  font-size: 1.05rem;
  line-height: 1;
  padding: 0 2px;
}
.detail-close:hover {
  color: var(--fg-strong);
}
.detail-title {
  font-size: 1.02rem;
  color: var(--fg-strong);
  margin-bottom: 11px;
  word-break: break-word;
}
.detail-body {
  overflow-y: auto;
  overflow-x: hidden;
  font-size: 0.82rem;
}
