/* Rendered-markdown styling (BT-172), shared by the docs preview and every
   detail overlay - content must read the same wherever a page appears. The
   global reset zeroes list padding, so ol/ul restore it here or their markers
   clip, which is what read as "the parser is broken". */
.md-content {
  font-size: 0.88rem;
  line-height: 1.55;
}
.md-content h1,
.md-content h2,
.md-content h3 {
  color: var(--fg-strong);
  font-weight: 400;
  margin: 1.1em 0 0.45em;
}
.md-content h1 {
  font-size: 1.25rem;
}
.md-content h2 {
  font-size: 1.05rem;
}
.md-content p {
  margin: 0.55em 0;
}
.md-content ul,
.md-content ol {
  margin: 0.55em 0;
  padding-left: 1.5em;
}
.md-content li {
  margin: 0.15em 0;
}
.md-content a {
  color: var(--accent);
}
.md-content code {
  background: rgba(127, 127, 127, 0.14);
  padding: 0.1em 0.3em;
  border-radius: 3px;
  font-size: 0.95em;
}
.md-content pre {
  background: rgba(127, 127, 127, 0.1);
  padding: 0.7rem 0.9rem;
  border-radius: var(--radius-sm);
  overflow-x: auto;
  margin: 0.55em 0;
}
.md-content pre code {
  background: none;
  padding: 0;
}
.md-content table {
  border-collapse: collapse;
  margin: 0.7em 0;
  display: block;
  overflow-x: auto;
}
.md-content th,
.md-content td {
  border: 1px solid var(--border);
  padding: 0.3em 0.6em;
  text-align: left;
}
.md-content th {
  color: var(--fg-strong);
}
.md-content blockquote {
  border-left: 3px solid var(--accent);
  margin: 0.7em 0;
  padding: 0.1em 0 0.1em 0.9em;
  color: var(--fg-muted);
}
.md-content input[type="checkbox"] {
  accent-color: var(--accent);
}
.md-content hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 1em 0;
}
